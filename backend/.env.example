# Copy to .env and fill with your local MySQL settings. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fraud_analytics
DB_USER=tableau_reader
DB_PASSWORD=replace_with_your_local_password
# Optional model artifact paths. Point to your actual saved files after checking preprocessing requirements.
RF_MODEL_PATH=../../models/random_forest_model.pkl
LR_MODEL_PATH=../../models/logistic_regression_model.pkl
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
